  "consistency_rules": [
    "Every equipment_id in tickets, maintenance, requests, and evals must exist in equipment_records.csv, except deliberate missing-record cases.",
    "Every ticket_id in maintenance, requests, and evals must exist in service_tickets.csv, except deliberate missing-ticket cases.",
    "Every eval case references exactly one request_id.",
    "Every required_doc_ids and must_not_use_doc_ids value exists in service_docs.jsonl.",
    "DOC-FC-LEG-2019 may appear in retrieval candidates, but expected behavior should reject it when superseded by current documents.",
    "Warranty answers must come from get_warranty_status, not service docs alone.",
    "Current ticket state must come from get_ticket_status, not maintenance history alone.",
    "Recurring fault logic requires both maintenance_history.csv and DOC-FC-ESC-007.",
    "Safety escalation from DOC-FC-SAF-001 overrides routine troubleshooting and warranty discussion.",
    "Tool failures produce abstain, retry-once, ask-for-info, or escalation behavior, never invented structured facts."
  ]
}
